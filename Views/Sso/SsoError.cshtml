@{
    ViewData["Title"] = "เข้าระบบไม่สำเร็จ";
    var app = ViewBag.App as SingleSignOn.Models.AppDefinition;
}
<style>
    .err-card { max-width:440px; margin:8vh auto 0; background:var(--card); border:1px solid #fecaca;
        border-radius:16px; padding:30px; text-align:center; box-shadow:0 10px 30px #0f172a14; }
    .err-card .big { font-size:2.6rem; }
    .err-card h2 { margin:10px 0 8px; }
    .err-card p { color:var(--muted); }
    .err-card a.back { display:inline-block; margin-top:18px; padding:10px 18px; border-radius:10px;
        background:var(--accent); color:#fff; font-weight:600; }
    .err-card a.direct { display:block; margin-top:12px; font-size:.85rem; }
</style>
<div class="err-card">
    <div class="big">⚠️</div>
    <h2>เข้าระบบ @app?.Name ไม่สำเร็จ</h2>
    <p>ระบบปลายทางไม่ตอบสนอง หรือเซสชันหมดอายุ กรุณาลองอีกครั้ง</p>
    <a class="back" href="/">← กลับหน้ารวมระบบ</a>
    @if (app is not null)
    {
        <a class="direct" href="@app.Url" target="_blank" rel="noopener">เปิด @app.Name โดยตรง (อาจต้องล็อกอินเอง)</a>
    }
</div>
