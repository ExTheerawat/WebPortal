@model SingleSignOn.Models.ResetPasswordViewModel
@{ ViewData["Title"] = "ตั้งรหัสผ่านใหม่"; }
@await Html.PartialAsync("_AuthStyles")

<div class="auth-wrap">
    <div class="auth-card">
        <div class="logo-wrap">
            <img src="/img/ccpbg-logo.png" onerror="this.onerror=null;this.src='/img/CCPBG.jpg'" alt="CCPBG">
        </div>
        <h1>ตั้งรหัสผ่านใหม่</h1>
        <p class="sub">กรอกรหัสผ่านใหม่ที่ต้องการใช้กับบัญชีของคุณ</p>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="err">@Model.Error</div>
        }

        <form method="post" asp-controller="Account" asp-action="ResetPassword">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <div class="field">
                <label asp-for="NewPassword"></label>
                <div class="pwd-wrap">
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" autofocus />
                    <button type="button" class="pwd-eye" id="pwdToggle" title="แสดง/ซ่อนรหัสผ่าน">
                        <svg id="eyeOpen" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg id="eyeOff" style="display:none" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
                <span class="val" asp-validation-for="NewPassword"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span class="val" asp-validation-for="ConfirmPassword"></span>
            </div>
            <button class="btn-login" type="submit">บันทึกรหัสผ่านใหม่</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var pwd = document.getElementById('NewPassword'),
                btn = document.getElementById('pwdToggle'),
                o = document.getElementById('eyeOpen'),
                f = document.getElementById('eyeOff');
            if (btn && pwd) btn.addEventListener('click', function () {
                var hidden = pwd.type === 'password';
                pwd.type = hidden ? 'text' : 'password';
                o.style.display = hidden ? 'none' : '';
                f.style.display = hidden ? '' : 'none';
                pwd.focus();
            });
        })();
    </script>
}
