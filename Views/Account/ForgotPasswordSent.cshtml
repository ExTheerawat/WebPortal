@model SingleSignOn.Models.ForgotPasswordViewModel
@{ ViewData["Title"] = "ส่งลิงก์แล้ว"; }
@await Html.PartialAsync("_AuthStyles")

<div class="auth-wrap">
    <div class="auth-card">
        <div class="big-ico ok">✉️</div>
        <h1>ส่งลิงก์แล้ว</h1>
        <p class="sub">
            เราได้ส่งลิงก์สำหรับตั้งรหัสผ่านใหม่ไปที่<br>
            <b>@Model.Email</b><br><br>
            กรุณาตรวจสอบกล่องอีเมล (รวมถึงโฟลเดอร์ Junk/Spam) แล้วกดลิงก์ในอีเมลเพื่อตั้งรหัสผ่านใหม่
        </p>
        <div class="auth-foot"><a asp-controller="Account" asp-action="Login">← กลับไปหน้าเข้าสู่ระบบ</a></div>
    </div>
</div>
