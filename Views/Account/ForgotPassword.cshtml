@model SingleSignOn.Models.ForgotPasswordViewModel
@{ ViewData["Title"] = "ลืมรหัสผ่าน"; }
@await Html.PartialAsync("_AuthStyles")

<div class="auth-wrap">
    <div class="auth-card">
        <div class="logo-wrap">
            <img src="/img/ccpbg-logo.png" onerror="this.onerror=null;this.src='/img/CCPBG.jpg'" alt="CCPBG">
        </div>
        <h1>ลืมรหัสผ่าน</h1>
        <p class="sub">กรอกอีเมลที่ใช้เข้าระบบ เราจะส่งลิงก์สำหรับตั้งรหัสผ่านใหม่ไปให้ทางอีเมล</p>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="err">@Model.Error</div>
        }

        <form method="post" asp-controller="Account" asp-action="ForgotPassword">
            @Html.AntiForgeryToken()
            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" autocomplete="email" autofocus />
                <span class="val" asp-validation-for="Email"></span>
            </div>
            <button class="btn-login" type="submit">ส่งลิงก์ตั้งรหัสผ่านใหม่</button>
        </form>

        <div class="auth-foot"><a asp-controller="Account" asp-action="Login">← กลับไปหน้าเข้าสู่ระบบ</a></div>
    </div>
</div>
