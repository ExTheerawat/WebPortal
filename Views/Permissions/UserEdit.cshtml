@model SingleSignOn.Models.UserEditViewModel
@{
    ViewData["Title"] = "แก้ไขสิทธิ์ผู้ใช้";
}
<style>
    .pm-top { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:22px; flex-wrap:wrap; }
    .pm-top h1 { margin:0; font-size:1.5rem; display:flex; align-items:center; gap:8px; }
    .btn { height:40px; padding:0 18px; display:inline-flex; align-items:center; justify-content:center; gap:7px;
           border-radius:10px; font-weight:600; font-size:.9rem; border:1px solid var(--border); background:#fff;
           color:var(--text); cursor:pointer; text-decoration:none; line-height:1; white-space:nowrap; transition:all .12s; }
    .btn:hover { border-color:var(--accent); color:var(--accent); }
    .btn.primary { background:var(--accent); color:#fff; border-color:var(--accent); }
    .btn.primary:hover { filter:brightness(1.06); color:#fff; }
    .card { background:var(--card); border:1px solid var(--border); border-radius:16px; padding:24px 26px;
            box-shadow:0 1px 3px #0f172a0d; max-width:680px; }
    .field { margin-bottom:18px; }
    .field > label { display:block; font-size:.8rem; font-weight:600; color:var(--muted); margin-bottom:8px; }
    .email-box { font-weight:600; font-size:1.02rem; padding:11px 13px; background:#f8fafc; border:1px solid var(--border); border-radius:10px; }
    .apps-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:10px; }
    .app-chk { display:flex; align-items:center; gap:9px; border:1px solid var(--border); border-radius:10px; padding:11px 13px; cursor:pointer; transition:all .12s; }
    .app-chk:hover { border-color:var(--accent); }
    .app-chk input, .toggles input { width:17px; height:17px; accent-color:var(--accent); cursor:pointer; }
    .toggles { display:flex; gap:28px; flex-wrap:wrap; }
    .toggles label { display:flex; align-items:center; gap:9px; cursor:pointer; font-size:.92rem; }
    .form-actions { display:flex; gap:12px; margin-top:6px; }
</style>

<div class="pm-top">
    <h1>✏️ แก้ไขสิทธิ์ผู้ใช้</h1>
    <a class="btn" asp-action="Index">← กลับ</a>
</div>

<div class="card">
    <div class="field">
        <label>อีเมล</label>
        <div class="email-box">@Model.User.Email</div>
    </div>

    <form method="post" asp-action="Save">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userKey" value="@Model.User.UserKey" />

        <div class="field">
            <label>ระบบที่ให้เห็น</label>
            <div class="apps-grid">
                @foreach (var app in Model.AllApps)
                {
                    var on = Model.User.Apps.Any(a => string.Equals(a, app.Key, StringComparison.OrdinalIgnoreCase));
                    <label class="app-chk">
                        <input type="checkbox" name="apps" value="@app.Key" @(on ? "checked" : "") />
                        <span>@app.Icon @app.Name</span>
                    </label>
                }
            </div>
        </div>

        <div class="field">
            <div class="toggles">
                <label><input type="checkbox" name="isAdmin" value="true" @(Model.User.IsAdmin ? "checked" : "") /> เป็นผู้ดูแล (เห็นเมนูจัดการสิทธิ์)</label>
                <label><input type="checkbox" name="isActive" value="true" @(Model.User.IsActive ? "checked" : "") /> เปิดใช้งาน</label>
            </div>
        </div>

        <div class="form-actions">
            <button class="btn primary" type="submit">💾 บันทึก</button>
            <a class="btn" asp-action="Index">ยกเลิก</a>
        </div>
    </form>
</div>
